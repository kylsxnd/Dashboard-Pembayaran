                }

                let user = JSON.parse(localStorage.getItem('agrinas_user'));
                user.name = newName;
                user.photo = newPhoto;
                localStorage.setItem('agrinas_user', JSON.stringify(user));

                let users = JSON.parse(localStorage.getItem('agrinas_users') || '[]');
                let idx = users.findIndex(u => u.email === user.email);
                if(idx !== -1) {
                    users[idx].name = newName;
