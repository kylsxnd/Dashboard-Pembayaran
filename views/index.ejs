                                        dokHTML = `
                                            <button onclick="openSmartChipModal('${safeName}')" class="inline-flex items-center gap-2 text-emerald-400 font-medium hover:text-emerald-300 transition-colors cursor-pointer text-left focus:outline-none truncate max-w-[200px] md:max-w-[250px] hover:-translate-y-0.5" title="${safeName}">
                                                <svg class="w-4 h-4 md:w-5 md:h-5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg> 
                                                <span class="underline decoration-emerald-500/30 underline-offset-4 truncate">${dokVal}</span>
                                            </button>
                                        `;
                                    }
                                }

                                if (isPaid || isReview) {
                                    let taskItemHTML = `
                                        <div class="flex-shrink-0 bg-zinc-800/40 border border-white/5 rounded-2xl p-4 md:p-5 flex justify-between items-center hover:bg-zinc-700/60 hover:border-white/10 hover:-translate-y-1 hover:shadow-lg transition-all duration-300 gap-4 cursor-default group relative overflow-hidden">
                                            <div class="absolute left-0 top-0 w-1.5 h-full opacity-80 group-hover:opacity-100 transition-opacity duration-300 ${isPaid ? 'bg-emerald-500' : 'bg-purple-500'}"></div>
                                            <div class="flex-1 min-w-0 pl-3">
                                                <p class="text-white font-bold text-xs md:text-sm mb-2 group-hover:text-emerald-200 transition-colors truncate" title="${croVal} - ${wilVal}">${croVal} <span class="text-gray-500 font-normal ml-1">(${wilVal})</span></p>
                                                <p class="text-[10px] md:text-xs text-gray-400 mb-2 truncate" title="${ketVal}">Ket: <span class="text-emerald-400 font-semibold">${ketVal}</span></p>
                                                <p class="text-[11px] md:text-sm font-black text-emerald-400">${permStr}</p>
                                            </div>
                                            <span class="px-3 md:px-4 py-1.5 md:py-2 rounded-lg text-[10px] md:text-xs font-black ${isPaid ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-purple-500/20 text-purple-400 border border-purple-500/30'} whitespace-nowrap uppercase flex-shrink-0 group-hover:scale-105 transition-transform tracking-wide">
                                                ${progVal}
                                            </span>
                                        </div>
                                    `;

                                    if (isPaid) {
                                        paidCount++;
                                        paidContainer.insertAdjacentHTML('beforeend', taskItemHTML);
                                    } else {
                                        unpaidCount++;
                                        unpaidContainer.insertAdjacentHTML('beforeend', taskItemHTML);
                                    }
                                }

                                let cellData = [ colZero, croVal, wilVal, pemStr, sisaStr, permStr, lpjHTML, sreqHTML, ketVal, progHTML, dokHTML ];

                                let rowHTML = '<tr class="hover:bg-zinc-800/80 transition-colors duration-200 group">';
                                cellData.forEach((cellVal, c) => {
                                    let cellClasses = "px-5 md:px-8 py-5 md:py-6 border-b border-white/5 align-middle text-gray-300 whitespace-nowrap";
                                    if (c === 8) cellClasses = "px-5 md:px-8 py-5 md:py-6 border-b border-white/5 align-middle text-gray-200 font-medium min-w-[200px] md:min-w-[250px] max-w-[300px] md:max-w-[400px] whitespace-normal leading-relaxed";
                                    rowHTML += `<td class="${cellClasses}">${cellVal}</td>`;
                                });
                                rowHTML += '</tr>';
                                allTableRowsHTML.push(rowHTML);
                            }

                            if (titlePaidPanel) titlePaidPanel.innerHTML = `<div class="p-2 bg-emerald-500/10 rounded-lg border border-emerald-500/20"><svg class="w-4 h-4 md:w-5 md:h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div> Status Lunas <span class="ml-auto md:ml-3 px-3 py-1.5 rounded-lg bg-emerald-500 text-white font-black text-[10px] md:text-xs shadow-[0_2px_15px_rgba(16,185,129,0.4)] flex-shrink-0 tracking-wide">${paidCount} PAID</span>`;
                            if (titleUnpaidPanel) titleUnpaidPanel.innerHTML = `<div class="p-2 bg-purple-500/10 rounded-lg border border-purple-500/20"><svg class="w-4 h-4 md:w-5 md:h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div> Status Review <span class="ml-auto md:ml-3 px-3 py-1.5 rounded-lg bg-purple-500 text-white font-black text-[10px] md:text-xs shadow-[0_2px_15px_rgba(168,85,247,0.4)] flex-shrink-0 tracking-wide">${unpaidCount} REVIEW</span>`;

                            if (paidContainer.innerHTML === '') paidContainer.innerHTML = `<div class="p-5 border border-dashed border-emerald-500/20 rounded-2xl text-center"><p class="text-xs md:text-sm text-emerald-500/50 italic font-medium">Belum ada pengajuan yang lunas.</p></div>`;
                            if (unpaidContainer.innerHTML === '') unpaidContainer.innerHTML = `<div class="p-5 border border-dashed border-purple-500/20 rounded-2xl text-center"><p class="text-xs md:text-sm text-purple-500/50 italic font-medium">Tidak ada pengajuan yang sedang di-review.</p></div>`;

                            if (allTableRowsHTML.length === 0) {
                                document.getElementById('table-body').innerHTML = `<tr><td colspan="11" class="px-6 py-16 text-center text-gray-500 font-medium text-sm md:text-base">Tidak ada baris data di sheet Petty Cash ini.</td></tr>`;
                            } else {
                                renderTablePage();
                            }
                            
                            let syncTime = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                            document.getElementById('last-update').innerHTML = `Data API <span class="text-emerald-400 font-bold ml-1">${syncTime}</span>`;
                            
                            const dateDisplay = document.getElementById('top-date-display');
                            const dateValueEl = document.getElementById('top-date-value');
                            if (globalDate && globalDate !== '-') {
                                dateValueEl.innerText = globalDate;
                                dateDisplay.classList.remove('hidden');
                            } else {
                                dateDisplay.classList.add('hidden');
                            }
                        }

                        // =========================================================
                        // KONDISI UMUM
                        // =========================================================
                        else {
                            let tableHeadIdx = 2; 
                            let dataStartIdx = tableHeadIdx + 1;
                            while (dataStartIdx < data.length) {
                                let col0 = data[dataStartIdx][0] ? data[dataStartIdx][0].toString().trim() : "";
                                let col1 = data[dataStartIdx][1] ? data[dataStartIdx][1].toString().trim() : "";
                                if (/^\d+$/.test(col0) || /\d{1,2}\s[a-zA-Z]+\s\d{4}/.test(col1) || col1.includes('00:00:00')) break;
                                dataStartIdx++;
                            }
                            if (dataStartIdx >= data.length) dataStartIdx = tableHeadIdx + 1;

                            let validColIndices = [];
                            let headHTML = '<tr>';
                            for (let c = 0; c < data[tableHeadIdx].length; c++) {
                                let headerText = data[tableHeadIdx][c] ? data[tableHeadIdx][c].toString().trim() : "";
                                if (headerText !== "") {
                                    validColIndices.push(c);
                                    headHTML += `<th class="px-5 md:px-8 py-4 md:py-6 font-bold bg-zinc-900/95 backdrop-blur-md sticky top-0 z-10 border-b border-white/10 whitespace-nowrap align-bottom">${headerText}</th>`;
                                }
                            }
                            headHTML += '</tr>';
                            thead.innerHTML = headHTML;

                            for (let i = dataStartIdx; i < data.length; i++) {
                                let row = data[i];
                                let rowStr = row.join('').trim();
                                if (rowStr === '' || !rowStr.match(/[a-zA-Z0-9]/)) continue;

                                let rowHTML = '<tr class="hover:bg-zinc-800/80 transition-colors duration-200 group">';
                                validColIndices.forEach((colIndex) => {
                                    let cellVal = row[colIndex] !== undefined && row[colIndex] !== null ? row[colIndex] : '-';
                                    if (cellVal !== '-') cellVal = formatCellDate(cellVal);
                                    if (cellVal === 'nan' || cellVal === '') cellVal = '-';
                                    rowHTML += `<td class="px-5 md:px-8 py-4 md:py-6 border-b border-white/5 text-gray-300 whitespace-nowrap">${cellVal}</td>`;
                                });
                                rowHTML += '</tr>';
                                allTableRowsHTML.push(rowHTML);
                            }

                            if (allTableRowsHTML.length === 0) {
                                document.getElementById('table-body').innerHTML = `<tr><td colspan="10" class="px-6 py-16 text-center text-gray-500 font-medium text-sm md:text-base">Tidak ada baris data di sheet ini.</td></tr>`;
                                document.getElementById('pagination-container').innerHTML = '';
                            } else {
                                renderTablePage();
                            }
                            
                            let syncTime = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                            document.getElementById('last-update').innerHTML = `Data API <span class="text-emerald-400 font-bold ml-1">${syncTime}</span>`;
                            const dateDisplay = document.getElementById('top-date-display');
                            dateDisplay.classList.add('hidden');
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        if (!isSilent) {
                            document.getElementById('table-head').innerHTML = '';
                            document.getElementById('table-body').innerHTML = `<tr><td colspan="16" class="px-6 py-16 text-center text-red-500 font-medium text-sm md:text-base">Gagal memuat data dari server. Pastikan nama sheet benar.</td></tr>`;
                        }
                    });
            }

            renderMenu();
            fetchJsonData(); 
            
            setInterval(() => {
                fetchJsonData(true);
            }, 10000);
        });
    </script>
</body>
</html>
