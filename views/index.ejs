                                if (filledCols > 2) {
                                    headers = row;
                                    headerIndex = i;
                                    break;
                                }
                            }

                            if (headerIndex !== -1) {
                                let theadHTML = '<tr>';
                                headers.forEach(headerText => {
                                    let hText = headerText || '-';
                                    theadHTML += `<th class="px-5 md:px-8 py-4 md:py-6 font-bold bg-black/50 backdrop-blur-md sticky top-0 z-10 border-b border-white/20 whitespace-nowrap align-bottom drop-shadow-md text-gray-200">${hText}</th>`;
                                });
                                theadHTML += '</tr>';
                                thead.innerHTML = theadHTML;

                                for (let i = headerIndex + 1; i < data.length; i++) {
                                    let row = data[i] || [];
                                    if (row.every(cell => cell === null || cell === '')) continue;
                                    
                                    let trHTML = '<tr class="hover:bg-white/5 transition-colors duration-200 group">';
                                    for (let c = 0; c < headers.length; c++) {
                                        let cellData = row[c] !== undefined && row[c] !== null ? row[c] : '-';
                                        trHTML += `<td class="px-5 md:px-8 py-5 md:py-6 border-b border-white/10 align-middle text-gray-200 whitespace-nowrap font-medium drop-shadow-sm">${cellData}</td>`;
                                    }
                                    trHTML += '</tr>';
                                    allTableRowsHTML.push(trHTML);
                                }
                            }
                            
                            noSummaryMsg.classList.remove('hidden');
                            document.getElementById('top-date-display').classList.add('hidden');
                            filterContainer.classList.add('hidden');
                            
                            if (allTableRowsHTML.length === 0) {
                                tbody.innerHTML = `<tr><td colspan="20" class="px-6 py-16 text-center text-gray-400 font-bold text-sm md:text-base bg-black/20 backdrop-blur-sm">Tidak ada baris data.</td></tr>`;
                            } else {
                                renderTablePage();
                            }
                        }

                        let syncTime = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                        document.getElementById('last-update').innerHTML = `Data API <span class="text-emerald-400 font-bold ml-1 drop-shadow-[0_0_5px_currentColor]">${syncTime}</span>`;
                        
                        const dateDisplay = document.getElementById('top-date-display');
                        const dateValueEl = document.getElementById('top-date-value');
                        if (window.selectedMonthFilter !== 'ALL' && currentActiveSheet !== 'Petty Cash') {
                            dateValueEl.innerText = 'Bulan ' + window.selectedMonthFilter.charAt(0) + window.selectedMonthFilter.slice(1).toLowerCase();
                            dateDisplay.classList.remove('hidden');
                        } else {
                            dateDisplay.classList.add('hidden');
                        }

                    })
                    .catch(error => {
                        console.error('Error fetching data:', error);
                        tbody.innerHTML = `<tr><td colspan="20" class="p-16 text-center flex flex-col justify-center items-center gap-4"><div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-rose-500/20 flex items-center justify-center border border-rose-500/30 shadow-inner"><svg class="w-6 h-6 md:w-8 md:h-8 text-rose-500 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div><div class="text-rose-400 font-bold text-sm md:text-base drop-shadow-sm">Gagal memuat data sheet ini.</div><div class="text-xs md:text-sm text-gray-400">Pastikan backend berjalan dan API Key Google valid.</div></td></tr>`;
                        dashboardWidgets.classList.add('hidden');
                        pdoBreakdown.classList.add('hidden');
                        croBreakdownSection.classList.add('hidden');
                        document.getElementById('last-update').innerHTML = `Data API <span class="text-rose-400 font-bold ml-1">Error</span>`;
                    });
            }

            function renderSummaryCards(labels, values) {
                const container = document.getElementById('summaryCardsContainer');
                container.innerHTML = '';
                let colorClass = 'emerald';
                if (currentActiveSheet === 'PDO') colorClass = 'sky';
                else if (currentActiveSheet === 'Petty Cash') colorClass = 'pink';
                else if (currentActiveSheet === 'Status Input Asta') colorClass = 'indigo';
                else if (currentActiveSheet === 'Surat Keluar') colorClass = 'teal';

                container.className = `grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3 md:gap-5 relative z-10`;

                labels.forEach((label, i) => {
                    let val = values[i];
                    if(val === undefined || val === null || val === '') val = '0';
                    let titleHTML = `<p class="text-[9px] md:text-[10px] text-gray-400 font-black uppercase tracking-widest drop-shadow-sm mb-1 line-clamp-2">${label}</p>`;
                    let valueHTML = `<h2 class="text-xl md:text-2xl font-black text-white drop-shadow-md tracking-tight leading-none">${val}</h2>`;
                    
                    const cardHTML = `
                        <div class="bg-black/30 backdrop-blur-md rounded-2xl p-4 md:p-5 border border-white/10 flex flex-col justify-center hover:bg-black/50 hover:border-${colorClass}-500/50 transition-all duration-300 shadow-inner group relative overflow-hidden transform hover:-translate-y-1">
                            <div class="absolute inset-0 bg-gradient-to-tr from-${colorClass}-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                            <div class="relative z-10">
                                ${titleHTML}
                                ${valueHTML}
                            </div>
                        </div>
                    `;
                    container.insertAdjacentHTML('beforeend', cardHTML);
                });
            }

            function renderCroBreakdown(croMap) {
                const container = document.getElementById('croCardsContainer');
                container.innerHTML = '';
                
                let colorTheme = 'emerald';
                if (currentActiveSheet === 'Status Input Asta') colorTheme = 'indigo';
                else if (currentActiveSheet === 'Surat Keluar') colorTheme = 'teal';

                Object.keys(croMap).sort().forEach(cro => {
                    const data = croMap[cro];
                    let amountHtml = '';
                    if (data.totalAmount !== undefined && data.totalAmount > 0) {
                        amountHtml = `<p class="text-[10px] md:text-xs font-black text-${colorTheme}-400 mt-2 tracking-wide drop-shadow-sm truncate">${formatRupiah(data.totalAmount)}</p>`;
                    }
                    
                    const cardHtml = `
                        <div class="bg-black/30 border border-white/10 rounded-2xl p-4 md:p-5 flex flex-col gap-2 hover:bg-black/50 hover:border-${colorTheme}-400/30 transition-all shadow-inner group">
                            <div class="flex justify-between items-center border-b border-white/5 pb-2">
                                <h4 class="text-white font-black text-xs md:text-sm tracking-wide drop-shadow-md truncate w-2/3 group-hover:text-${colorTheme}-300 transition-colors">${cro}</h4>
                                <span class="text-[9px] md:text-[10px] bg-white/10 text-gray-300 px-2 py-0.5 rounded font-bold tracking-wider">TOTAL: ${data.total}</span>
                            </div>
                            <div class="flex justify-between items-center mt-1">
                                <p class="text-[10px] md:text-xs font-bold text-gray-400 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-${colorTheme}-400 shadow-[0_0_8px_rgba(var(--tw-color-${colorTheme}-400),0.8)]"></span>Paid: <span class="text-white">${data.paid}</span></p>
                                <p class="text-[10px] md:text-xs font-bold text-gray-400 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-rose-400 shadow-[0_0_8px_rgba(244,63,94,0.8)]"></span>Pending: <span class="text-white">${data.pending}</span></p>
                            </div>
                            ${amountHtml}
                        </div>
                    `;
                    container.insertAdjacentHTML('beforeend', cardHtml);
                });
            }

            function renderTablePage() {
                const tbody = document.getElementById('table-body');
                const startIdx = (currentPage - 1) * rowsPerPage;
                const endIdx = startIdx + rowsPerPage;
                const pageRows = allTableRowsHTML.slice(startIdx, endIdx);
                
                tbody.innerHTML = pageRows.join('');
                setupPagination();
            }

            function setupPagination() {
                const totalPages = Math.ceil(allTableRowsHTML.length / rowsPerPage);
                const container = document.getElementById('pagination-container');
                container.innerHTML = '';

                if (totalPages <= 1) return;

                let colorTheme = 'emerald';
                if (currentActiveSheet === 'PDO') colorTheme = 'sky';
                else if (currentActiveSheet === 'Petty Cash') colorTheme = 'pink';
                else if (currentActiveSheet === 'Status Input Asta') colorTheme = 'indigo';
                else if (currentActiveSheet === 'Surat Keluar') colorTheme = 'teal';

                const prevBtn = document.createElement('button');
                prevBtn.innerHTML = `<svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>`;
                prevBtn.className = `p-1.5 md:p-2 rounded-lg bg-white/5 border border-white/10 text-gray-400 hover:text-white hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-${colorTheme}-500 disabled:opacity-30 disabled:cursor-not-allowed`;
                prevBtn.disabled = currentPage === 1;
                prevBtn.onclick = () => { if (currentPage > 1) { currentPage--; renderTablePage(); } };
                container.appendChild(prevBtn);

                let maxPagesToShow = window.innerWidth < 768 ? 3 : 5;
                let startPage = Math.max(1, currentPage - Math.floor(maxPagesToShow / 2));
                let endPage = Math.min(totalPages, startPage + maxPagesToShow - 1);

                if (endPage - startPage + 1 < maxPagesToShow) {
                    startPage = Math.max(1, endPage - maxPagesToShow + 1);
                }

                if (startPage > 1) {
                    container.appendChild(createPageBtn(1, colorTheme));
                    if (startPage > 2) {
                        const ellipsis = document.createElement('span');
                        ellipsis.className = 'text-gray-500 font-bold px-1 md:px-2';
                        ellipsis.innerText = '...';
                        container.appendChild(ellipsis);
                    }
                }

                for (let i = startPage; i <= endPage; i++) {
                    container.appendChild(createPageBtn(i, colorTheme));
                }

                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) {
                        const ellipsis = document.createElement('span');
                        ellipsis.className = 'text-gray-500 font-bold px-1 md:px-2';
                        ellipsis.innerText = '...';
                        container.appendChild(ellipsis);
                    }
                    container.appendChild(createPageBtn(totalPages, colorTheme));
                }

                const nextBtn = document.createElement('button');
                nextBtn.innerHTML = `<svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>`;
                nextBtn.className = `p-1.5 md:p-2 rounded-lg bg-white/5 border border-white/10 text-gray-400 hover:text-white hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-${colorTheme}-500 disabled:opacity-30 disabled:cursor-not-allowed`;
                nextBtn.disabled = currentPage === totalPages;
                nextBtn.onclick = () => { if (currentPage < totalPages) { currentPage++; renderTablePage(); } };
                container.appendChild(nextBtn);
            }

            function createPageBtn(pageNum, colorTheme) {
                const btn = document.createElement('button');
                btn.innerText = pageNum;
                if (pageNum === currentPage) {
                    btn.className = `w-8 h-8 md:w-10 md:h-10 rounded-xl bg-${colorTheme}-500 text-white font-black text-xs md:text-sm shadow-[0_4px_15px_rgba(var(--tw-color-${colorTheme}-500),0.5)] focus:outline-none drop-shadow-md border border-${colorTheme}-400/50`;
                } else {
                    btn.className = `w-8 h-8 md:w-10 md:h-10 rounded-xl bg-white/5 border border-white/10 text-gray-300 font-bold text-xs md:text-sm hover:bg-white/10 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-${colorTheme}-500`;
                    btn.onclick = () => { currentPage = pageNum; renderTablePage(); };
                }
                return btn;
            }
        });
    </script>
</body>
</html>
