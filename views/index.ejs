                                let row = data[i];
                                if (!row || row.every(val => val === null || val === '')) continue;
                                
                                let colZero = row[colIdx.no] !== undefined && row[colIdx.no] !== null ? row[colIdx.no].toString().trim() : '';
                                let fullText = row.join(' ').replace(/,/g, '').trim();

                                if ((colZero === '' || isNaN(colZero)) && fullText.toLowerCase().includes('bulan')) {
                                    let title = row.find(v => v !== null && v !== '') || fullText;
                                    
                                    let lowerTitle = title.toLowerCase();
                                    if (lowerTitle.includes('juni') || lowerTitle.includes('juli')) {
                                        skipSection = true;
                                        continue;
                                    } else {
                                        skipSection = false;
                                    }

                                    let rowHTML = `<tr><td colspan="11" class="px-6 py-5 bg-pink-500/20 text-pink-300 font-bold text-center text-xs tracking-widest uppercase border-b border-white/5 shadow-inner">${title}</td></tr>`;
                                    allTableRowsHTML.push(rowHTML);
                                    continue;
                                }

                                if (skipSection) continue;
                                if (colZero === '' || isNaN(colZero)) continue;

                                let croVal = row[colIdx.cro] !== undefined && row[colIdx.cro] !== null ? row[colIdx.cro].toString().trim() : '-';
                                let wilVal = row[colIdx.wil] !== undefined && row[colIdx.wil] !== null ? row[colIdx.wil].toString().trim() : '-';
                                
                                let pemVal = row[colIdx.pem] !== undefined && row[colIdx.pem] !== null ? row[colIdx.pem] : '-';
                                let sisaVal = row[colIdx.sisa] !== undefined && row[colIdx.sisa] !== null ? row[colIdx.sisa] : '-';
                                let permVal = row[colIdx.perm] !== undefined && row[colIdx.perm] !== null ? row[colIdx.perm] : '-';
                                
                                let lpjVal = row[colIdx.slpj];
                                let sreqVal = row[colIdx.sreq];
                                
                                let ketVal = row[colIdx.ket] !== undefined && row[colIdx.ket] !== null ? row[colIdx.ket].toString().trim() : '-';
                                let progVal = row[colIdx.prog] !== undefined && row[colIdx.prog] !== null ? row[colIdx.prog].toString().trim() : '-';
                                let dokVal = row[colIdx.dok] !== undefined && row[colIdx.dok] !== null ? row[colIdx.dok].toString().trim() : '-';

                                let formatRp = (val) => {
                                    if (val === '-' || val === '' || val === null || val === undefined) return '-';
                                    let cleanStr = val.toString().replace(/Rp/gi, '').replace(/,/g, '').replace(/\./g, '').trim();
                                    if (cleanStr === '' || cleanStr === '-') return '-';
                                    let numVal = parseFloat(cleanStr);
                                    return isNaN(numVal) ? '-' : new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(numVal);
                                };

                                let pemStr = formatRp(pemVal);
                                let sisaStr = formatRp(sisaVal);
                                let permStr = formatRp(permVal);

                                let formatCheck = (val) => {
                                    if (val === null || val === undefined || val === '') return `<div class="flex items-center justify-center w-6 h-6 rounded-md bg-black/20 border border-white/10 mx-auto"></div>`;
                                    let strVal = String(val).toUpperCase();
                                    let isTrue = strVal === 'TRUE' || val === 1 || val === '1' || val === true || strVal.includes('TRUE') || strVal.includes('☑');
                                    
                                    if (isTrue) {
                                        return `<div class="flex items-center justify-center w-6 h-6 rounded-md bg-blue-500 border border-blue-400 shadow-sm mx-auto"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></div>`;
                                    } else {
                                        return `<div class="flex items-center justify-center w-6 h-6 rounded-md bg-black/20 border border-white/10 mx-auto"></div>`;
                                    }
                                };
                                let lpjHTML = formatCheck(lpjVal);
                                let sreqHTML = formatCheck(sreqVal);

                                let rawProg = (progVal || '').toString().toLowerCase();
                                let isPaid = rawProg.includes('paid');
                                let isReview = rawProg.includes('review') || rawProg.includes('dirops');
                                let progHTML = '-';

                                if (isPaid) {
                                    progHTML = `<span class="px-3 py-1.5 rounded-lg text-[11px] font-bold tracking-wide bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 inline-block whitespace-nowrap">${progVal}</span>`;
                                } else if (isReview) {
                                    progHTML = `<span class="px-3 py-1.5 rounded-lg text-[11px] font-bold tracking-wide bg-purple-500/20 text-purple-400 border border-purple-500/30 inline-block whitespace-nowrap">${progVal}</span>`;
                                } else if (progVal !== '-' && progVal !== '') {
                                    progHTML = `<span class="px-3 py-1.5 rounded-lg text-[11px] font-bold tracking-wide bg-slate-500/10 text-slate-400 border border-slate-500/20 inline-block whitespace-nowrap">${progVal}</span>`;
                                }

                                let dokHTML = '-';
                                if (dokVal !== '-' && dokVal !== '') {
                                    const urlRegex = /(https?:\/\/[^\s]+)/g;
                                    if (urlRegex.test(dokVal)) {
                                        dokHTML = dokVal.replace(urlRegex, (url) => `<a href="${url}" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-bold tracking-wide bg-pink-500/20 text-pink-300 border border-pink-500/30 shadow-sm hover:bg-pink-500/30 transition-colors">Buka Dokumen</a>`);
                                    } else {
                                        const safeName = dokVal.replace(/'/g, "\\'");
                                        dokHTML = `
                                            <button onclick="openSmartChipModal('${safeName}')" class="inline-flex items-center gap-1.5 text-pink-300 font-medium hover:text-pink-200 transition-colors cursor-pointer text-left focus:outline-none truncate max-w-[150px]" title="${safeName}">
                                                <svg class="w-4 h-4 text-pink-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg> 
                                                <span class="underline decoration-pink-500/30 underline-offset-4 truncate">${dokVal}</span>
                                            </button>
                                        `;
                                    }
                                }

                                if (isPaid || isReview) {
                                    let taskItemHTML = `
                                        <div class="bg-white/[0.02] border border-white/5 rounded-xl p-3 flex justify-between items-center hover:bg-white/[0.04] transition-colors">
                                            <div class="pr-2">
                                                <p class="text-white font-medium text-xs mb-1 truncate max-w-[220px]" title="${croVal} - ${wilVal}">${croVal} <span class="text-pink-300">(${wilVal})</span></p>
                                                <p class="text-[10px] text-pink-300 truncate max-w-[220px]" title="${ketVal}">Ket: <span class="text-pink-400 font-semibold">${ketVal}</span></p>
                                                <p class="text-[10px] font-bold text-emerald-400 mt-1">${permStr}</p>
                                            </div>
                                            <span class="px-2.5 py-1 rounded-md text-[10px] font-bold ${isPaid ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-purple-500/20 text-purple-400 border border-purple-500/30'} whitespace-nowrap uppercase">
                                                ${progVal}
                                            </span>
                                        </div>
                                    `;

                                    if (isPaid) {
                                        paidContainer.insertAdjacentHTML('beforeend', taskItemHTML);
                                    } else {
                                        unpaidContainer.insertAdjacentHTML('beforeend', taskItemHTML);
                                    }
                                }

                                let cellData = [ colZero, croVal, wilVal, pemStr, sisaStr, permStr, lpjHTML, sreqHTML, ketVal, progHTML, dokHTML ];

                                let rowHTML = '<tr class="hover:bg-pink-900/40 transition-colors duration-200 group">';
                                cellData.forEach((cellVal, c) => {
                                    let cellClasses = "px-6 py-4 border-b border-white/5 align-middle text-pink-100 text-sm whitespace-nowrap";
                                    if (c === 8) cellClasses = "px-6 py-4 border-b border-white/5 align-middle text-pink-100 text-sm min-w-[200px] whitespace-normal leading-relaxed";
                                    rowHTML += `<td class="${cellClasses}">${cellVal}</td>`;
                                });
                                rowHTML += '</tr>';
                                allTableRowsHTML.push(rowHTML);
                            }

                            if (paidContainer.innerHTML === '') paidContainer.innerHTML = `<p class="text-xs text-pink-300 italic px-2">Belum ada pengajuan yang lunas.</p>`;
                            if (unpaidContainer.innerHTML === '') unpaidContainer.innerHTML = `<p class="text-xs text-pink-300 italic px-2">Tidak ada pengajuan yang sedang di-review.</p>`;

                            if (allTableRowsHTML.length === 0) {
                                document.getElementById('table-body').innerHTML = `<tr><td colspan="11" class="px-6 py-12 text-center text-pink-300">Tidak ada baris data di sheet Petty Cash ini.</td></tr>`;
                            } else {
                                renderTablePage();
                            }
                            document.getElementById('last-update').innerText = `Data Sinkron: Live Excel API`;
                        }

                        // =========================================================
                        // KONDISI UMUM
                        // =========================================================
                        else {
                            let tableHeadIdx = 2; 
                            let dataStartIdx = tableHeadIdx + 1;
                            while (dataStartIdx < data.length) {
                                let col0 = data[dataStartIdx][0] ? data[dataStartIdx][0].toString().trim() : "";
                                let col1 = data[dataStartIdx][1] ? data[dataStartIdx][1].toString().trim() : "";
                                if (/^\d+$/.test(col0) || /\d{1,2}\s[a-zA-Z]+\s\d{4}/.test(col1) || col1.includes('00:00:00')) break;
                                dataStartIdx++;
                            }
                            if (dataStartIdx >= data.length) dataStartIdx = tableHeadIdx + 1;

                            let validColIndices = [];
                            let headHTML = '<tr>';
                            for (let c = 0; c < data[tableHeadIdx].length; c++) {
                                let headerText = data[tableHeadIdx][c] ? data[tableHeadIdx][c].toString().trim() : "";
                                if (headerText !== "") {
                                    validColIndices.push(c);
                                    headHTML += `<th class="px-6 py-4 font-bold bg-pink-950/90 backdrop-blur-md sticky top-0 z-10 border-b border-white/10 whitespace-nowrap align-bottom">${headerText}</th>`;
                                }
                            }
                            headHTML += '</tr>';
                            thead.innerHTML = headHTML;

                            for (let i = dataStartIdx; i < data.length; i++) {
                                let row = data[i];
                                let rowStr = row.join('').trim();
                                if (rowStr === '' || !rowStr.match(/[a-zA-Z0-9]/)) continue;

                                let rowHTML = '<tr class="hover:bg-pink-900/40 transition-colors duration-200 group">';
                                validColIndices.forEach((colIndex) => {
                                    let cellVal = row[colIndex] !== undefined && row[colIndex] !== null ? row[colIndex] : '-';
                                    if (cellVal !== '-') cellVal = formatCellDate(cellVal);
                                    if (cellVal === 'nan' || cellVal === '') cellVal = '-';
                                    rowHTML += `<td class="px-6 py-4 border-b border-white/5 text-pink-100 text-sm whitespace-nowrap">${cellVal}</td>`;
                                });
                                rowHTML += '</tr>';
                                allTableRowsHTML.push(rowHTML);
                            }

                            if (allTableRowsHTML.length === 0) {
                                document.getElementById('table-body').innerHTML = `<tr><td colspan="10" class="px-6 py-12 text-center text-pink-300">Tidak ada baris data di sheet ini.</td></tr>`;
                                document.getElementById('pagination-container').innerHTML = '';
                            } else {
                                renderTablePage();
                            }
                            document.getElementById('last-update').innerText = `Data Sinkron: Live Excel API`;
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        document.getElementById('table-head').innerHTML = '';
                        document.getElementById('table-body').innerHTML = `<tr><td colspan="16" class="px-6 py-12 text-center text-red-500">Gagal memuat data dari server. Pastikan nama sheet benar.</td></tr>`;
                        if (document.getElementById('dashboard-widgets')) document.getElementById('dashboard-widgets').classList.add('hidden');
                        if (document.getElementById('pdo-status-breakdown')) document.getElementById('pdo-status-breakdown').classList.add('hidden');
                    });
            }

            renderMenu();
            fetchJsonData(); 
        });
    </script>
</body>
</html>
