    <!-- BERSAMBUNG KE PART 2 -->
     <!-- BERSAMBUNG DARI PART 1 -->

    <script>
        // ========================================================
        // KONFIGURASI GLOBAL & UTILS
        // ========================================================
        window.selectedMonthFilter = 'ALL';
        let currentActiveSheet = ''; 
        let currentTableData = []; 
        let currentPage = 1; 
        const rowsPerPage = 10; 
        let allTableRowsHTML = [];

        function formatCheckmark(val) {
            let str = String(val).trim().toUpperCase();
            if (str === 'TRUE' || str === '1' || str === '1.0' || str.includes('☑') || str === 'Y' || str === 'YES') {
                return '<div class="flex justify-center"><div class="w-6 h-6 md:w-7 md:h-7 bg-emerald-500/20 backdrop-blur-md rounded-lg flex items-center justify-center border border-emerald-400/50 shadow-[0_0_10px_rgba(16,185,129,0.3)] transform transition-transform hover:scale-110"><svg class="w-4 h-4 md:w-5 md:h-5 text-emerald-400 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></div></div>';
            }
            return '<div class="flex justify-center"><div class="w-6 h-6 md:w-7 md:h-7 bg-white/5 backdrop-blur-md rounded-lg flex items-center justify-center border border-white/10 opacity-50"><svg class="w-3.5 h-3.5 md:w-4 md:h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path></svg></div></div>';
        }

        function formatCellDate(val) {
            if (!val || val === '-' || String(val) === 'nan' || String(val) === '') return '-';
            let str = String(val).trim();
            let match = str.match(/([A-Za-z]+)\s(\d{4})/);
            if (match) {
                return `<div class="flex items-center gap-2 bg-black/30 backdrop-blur-md px-3 md:px-4 py-1.5 md:py-2 rounded-lg border border-white/10 inline-flex shadow-inner"><svg class="w-3.5 h-3.5 md:w-4 md:h-4 text-emerald-400 drop-shadow-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg><span class="font-bold tracking-wide text-xs md:text-sm drop-shadow-md text-gray-200">${str}</span></div>`;
            }
            return str;
        }

        function formatRupiah(angka) {
            if (!angka || angka === '-' || isNaN(angka.toString().replace(/[^0-9.-]+/g, ""))) return '-';
            let num = parseFloat(angka.toString().replace(/[^0-9.-]+/g, ""));
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(num);
        }

        function extractCroName(croStr) {
            if (!croStr || croStr === '-' || String(croStr) === 'nan' || String(croStr) === '') return '';
            let s = String(croStr).toUpperCase().trim();
            let match = s.match(/CRO\s*([IVXLCDM\d]+)/);
            if (match) return `CRO ${match[1]}`;
            if (s.includes('CRO')) return s;
            return s;
        }

        function formatProgBadge(str) {
            if (!str || str === '-' || String(str) === 'nan' || String(str) === '') return '-';
            let s = String(str).trim();
            let up = s.toUpperCase();
            let color = 'gray';
            if (up.includes('SELESAI') || up.includes('APPROVED') || up.includes('APROVED')) color = 'emerald';
            else if (up.includes('PROSES') || up.includes('REVIEW') || up.includes('VERIFIKASI') || up.includes('PEMBUATAN')) color = 'amber';
            else if (up.includes('REVISI') || up.includes('KEMBALIKAN') || up.includes('DITOLAK')) color = 'rose';
            else if (up.includes('DIKIRIM') || up.includes('DISERAHKAN')) color = 'sky';
            else color = 'indigo';
            
            return `<div class="inline-flex flex-col gap-1 items-start">
                        <span class="px-3 md:px-4 py-1.5 rounded-lg text-[10px] md:text-xs font-black tracking-wider uppercase bg-${color}-500/20 text-${color}-300 border border-${color}-400/40 shadow-[0_4px_10px_rgba(0,0,0,0.2)] drop-shadow-md whitespace-nowrap">${s}</span>
                    </div>`;
        }

        function getCell(row, idx) { return (idx !== -1 && row[idx] !== undefined && row[idx] !== null) ? row[idx] : '-'; }

        // ========================================================
        // MODAL HANDLERS
        // ========================================================
        window.openSmartChipModal = function(name) {
            const modal = document.getElementById('custom-pdf-modal');
            const box = document.getElementById('pdf-modal-box');
            const content = document.getElementById('pdf-modal-content');
            const title = document.getElementById('pdf-modal-title');
            
            let colorTheme = document.body.classList.contains('theme-pink') ? 'pink' : 'emerald';
            
            title.innerText = `Preview: ${name}`;
            content.innerHTML = `
                <div class="w-20 h-20 md:w-24 md:h-24 bg-${colorTheme}-500/20 backdrop-blur-md rounded-2xl flex items-center justify-center mb-6 border border-${colorTheme}-400/40 shadow-[0_0_30px_rgba(var(--tw-color-${colorTheme}-500),0.3)] relative overflow-hidden group">
                    <div class="absolute inset-0 bg-gradient-to-tr from-${colorTheme}-400/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    <svg class="w-10 h-10 md:w-12 md:h-12 text-${colorTheme}-400 drop-shadow-lg transform group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                </div>
                <h4 class="text-white font-black text-lg md:text-xl mb-3 drop-shadow-md tracking-tight leading-tight px-4 max-w-full truncate" title="${name}">${name}</h4>
                <p class="text-sm text-gray-400 max-w-md mx-auto mb-8 font-medium px-4">Dokumen ini merupakan file internal/Smart Chip Google Docs. Silakan buka file aslinya langsung melalui Google Workspace atau klik link yang tersedia di spreadsheet jika ada.</p>
                <button onclick="document.getElementById('pdf-modal-close').click()" class="bg-white/10 hover:bg-white/20 text-white font-bold py-2.5 px-8 rounded-xl border border-white/20 transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5 tracking-wide focus:outline-none">Tutup Preview</button>
            `;
            
            modal.classList.remove('hidden');
            setTimeout(() => { modal.classList.remove('opacity-0'); box.classList.remove('scale-95'); }, 10);
        };

        document.getElementById('pdf-modal-close').addEventListener('click', () => {
            const modal = document.getElementById('custom-pdf-modal');
            const box = document.getElementById('pdf-modal-box');
            modal.classList.add('opacity-0'); box.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); document.getElementById('pdf-modal-content').innerHTML=''; }, 300);
        });

        // ========================================================
        // INIT & SIDEBAR MENU
        // ========================================================
        document.addEventListener('DOMContentLoaded', () => {
            // Cek Auth
            const userStr = localStorage.getItem('agrinas_user');
            if (userStr) {
                const user = JSON.parse(userStr);
                setupProfileData(user);
                showDashboard();
            } else {
                document.getElementById('auth-page').classList.remove('hidden');
                setTimeout(() => { document.getElementById('auth-page').classList.remove('opacity-0'); }, 10);
            }

            // Auth Handlers
            document.getElementById('go-to-register').addEventListener('click', () => {
                document.getElementById('login-form').classList.add('hidden');
                document.getElementById('register-form').classList.remove('hidden');
                document.getElementById('auth-error').classList.add('hidden');
            });
            document.getElementById('go-to-login').addEventListener('click', () => {
                document.getElementById('register-form').classList.add('hidden');
                document.getElementById('login-form').classList.remove('hidden');
                document.getElementById('auth-error').classList.add('hidden');
            });

            document.getElementById('register-form').addEventListener('submit', (e) => {
                e.preventDefault();
                const name = document.getElementById('reg-name').value;
                const email = document.getElementById('reg-email').value;
                const pass = document.getElementById('reg-password').value;
                
                if(pass.length < 6) {
                    showAuthError('Password minimal 6 karakter!'); return;
                }
                
                let users = JSON.parse(localStorage.getItem('agrinas_users') || '[]');
                if(users.find(u => u.email === email)) {
                    showAuthError('Email sudah terdaftar!'); return;
                }
                
                const newUser = { id: Date.now(), name, email, password: pass, photo: '' };
                users.push(newUser);
                localStorage.setItem('agrinas_users', JSON.stringify(users));
                localStorage.setItem('agrinas_user', JSON.stringify(newUser));
                
                setupProfileData(newUser);
                showDashboard();
            });

            document.getElementById('login-form').addEventListener('submit', (e) => {
                e.preventDefault();
                const email = document.getElementById('login-email').value;
                const pass = document.getElementById('login-password').value;
                
                if (email === 'admin@agrinas.id' && pass === 'admin123') {
                    const adminUser = { id: 1, name: 'Admin Pusat', email: 'admin@agrinas.id', photo: '' };
                    localStorage.setItem('agrinas_user', JSON.stringify(adminUser));
                    setupProfileData(adminUser);
                    showDashboard();
                    return;
                }
                
                let users = JSON.parse(localStorage.getItem('agrinas_users') || '[]');
                let user = users.find(u => u.email === email && u.password === pass);
                if (user) {
                    localStorage.setItem('agrinas_user', JSON.stringify(user));
                    setupProfileData(user);
                    showDashboard();
                } else {
                    showAuthError('Email atau password salah!');
